<Window x:Class="Memojang.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Memojang" Icon="Assets/Memojang.ico" Height="720" Width="1080" MinHeight="420" MinWidth="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuBarItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template" Value="{StaticResource MemojangMenuItemTemplate}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppMenuHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource MenuBarItemStyle}" />
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource AppControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1"
                                Margin="8,0"
                                Background="{DynamicResource AppBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarButtonStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppMenuHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppToggleThumbBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Width="1"
                                Height="22"
                                Margin="8,0"
                                Background="{DynamicResource AppBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Background="{DynamicResource AppWindowBrush}">
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppTopBarBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="38" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0"
                      Background="Transparent"
                      PreviewMouseLeftButtonDown="TitleBar_PreviewMouseLeftButtonDown"
                      MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel x:Name="TabStripPanel" Orientation="Horizontal" Margin="8,6,0,0" />
                    </ScrollViewer>
                    <Button Grid.Column="1"
                            x:Name="NewDocumentButton"
                            Content="+"
                            Style="{StaticResource TopBarButtonStyle}"
                            Margin="12,4,0,0"
                            Click="NewTabMenuItem_Click" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="MinimizeWindowButton"
                                Content="—"
                                Style="{StaticResource TopBarButtonStyle}"
                                Click="MinimizeWindowButton_Click" />
                        <Button x:Name="MaximizeRestoreButton"
                                Content="□"
                                Style="{StaticResource TopBarButtonStyle}"
                                Click="MaximizeRestoreWindowButton_Click" />
                        <Button x:Name="CloseWindowButton"
                                Content="×"
                                Style="{StaticResource WindowCloseButtonStyle}"
                                Click="ExitMenuItem_Click" />
                    </StackPanel>
                </Grid>

                <Menu Grid.Row="1"
                      Background="{DynamicResource AppTopBarBrush}"
                      Foreground="{DynamicResource AppTextBrush}"
                      ItemContainerStyle="{StaticResource MenuBarItemStyle}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem x:Name="FileMenuItem" Header="_File" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="RecentMenuItem" Header="_Recent" />
                <Separator />
                <MenuItem x:Name="NewTabMenuItem" Header="New _tab" InputGestureText="Ctrl+T" Click="NewTabMenuItem_Click" />
                <MenuItem x:Name="NewTextMenuItem" Header="New _text" InputGestureText="Ctrl+N" Click="NewTextMenuItem_Click" />
                <MenuItem x:Name="NewMarkdownMenuItem" Header="New _Markdown" InputGestureText="Ctrl+Shift+N" Click="NewMarkdownMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="OpenMenuItem" Header="_Open..." InputGestureText="Ctrl+O" Click="OpenMenuItem_Click" />
                <MenuItem x:Name="SaveMenuItem" Header="_Save" InputGestureText="Ctrl+S" Click="SaveMenuItem_Click" />
                <MenuItem x:Name="SaveAsMenuItem" Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsMenuItem_Click" />
                <MenuItem x:Name="SaveAllMenuItem" Header="Save A_ll" InputGestureText="Ctrl+Alt+S" Click="SaveAllMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ExitMenuItem" Header="E_xit" Click="ExitMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="EditMenuItem" Header="_Edit" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=EditorTextBox}" />
                <Separator />
                <MenuItem x:Name="CutMenuItem" Header="Cu_t" Command="ApplicationCommands.Cut" CommandTarget="{Binding ElementName=EditorTextBox}" />
                <MenuItem x:Name="CopyMenuItem" Header="_Copy" Command="ApplicationCommands.Copy" CommandTarget="{Binding ElementName=EditorTextBox}" />
                <MenuItem x:Name="PasteMenuItem" Header="_Paste" Command="ApplicationCommands.Paste" CommandTarget="{Binding ElementName=EditorTextBox}" />
                <Separator />
                <MenuItem x:Name="FindMenuItem" Header="_Find" InputGestureText="Ctrl+F" Click="FindMenuItem_Click" />
                <MenuItem x:Name="FindNextMenuItem" Header="Find _next" InputGestureText="F3" Click="FindNextMenuItem_Click" />
                <MenuItem x:Name="FindPreviousMenuItem" Header="Find _previous" InputGestureText="Shift+F3" Click="FindPreviousMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="SelectAllMenuItem" Header="Select _all" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll" CommandTarget="{Binding ElementName=EditorTextBox}" />
                <MenuItem x:Name="GoToMenuItem" Header="_Go to..." InputGestureText="Ctrl+G" Click="GoToMenuItem_Click" />
                <MenuItem x:Name="TimeDateMenuItem" Header="_Time/Date" InputGestureText="F5" Click="TimeDateMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="SettingsMenuItem" Header="_Settings">
                    <MenuItem x:Name="FontMenuItem" Header="_Font">
                        <MenuItem x:Name="FontConsolasMenuItem" Header="Consolas" IsCheckable="True" Click="EditorFontFamilyMenuItem_Click" />
                        <MenuItem x:Name="FontCascadiaMenuItem" Header="Cascadia Mono" IsCheckable="True" Click="EditorFontFamilyMenuItem_Click" />
                        <MenuItem x:Name="FontSegoeMenuItem" Header="Segoe UI" IsCheckable="True" Click="EditorFontFamilyMenuItem_Click" />
                    </MenuItem>
                    <MenuItem x:Name="FontSizeMenuItem" Header="Font _size">
                        <MenuItem x:Name="FontSizeSmallMenuItem" Header="_Small" IsCheckable="True" Click="EditorFontSizeMenuItem_Click" />
                        <MenuItem x:Name="FontSizeMediumMenuItem" Header="_Medium" IsCheckable="True" Click="EditorFontSizeMenuItem_Click" />
                        <MenuItem x:Name="FontSizeLargeMenuItem" Header="_Large" IsCheckable="True" Click="EditorFontSizeMenuItem_Click" />
                        <Separator />
                        <MenuItem x:Name="FontSizeCustomMenuItem" Header="_Custom..." Click="FontSizeCustomMenuItem_Click" />
                    </MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="ViewMenuItem" Header="_View" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="WordWrapMenuItem" Header="_Word wrap" IsCheckable="True" IsChecked="True" Click="WordWrapMenuItem_Click" />
                <MenuItem x:Name="StatusBarMenuItem" Header="_Status bar" IsCheckable="True" IsChecked="True" Click="StatusBarMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ZoomMenuItem" Header="_Zoom">
                    <MenuItem x:Name="ZoomInMenuItem" Header="Zoom _in" InputGestureText="Ctrl++" Click="ZoomInMenuItem_Click" />
                    <MenuItem x:Name="ZoomOutMenuItem" Header="Zoom _out" InputGestureText="Ctrl+-" Click="ZoomOutMenuItem_Click" />
                    <MenuItem x:Name="ResetZoomMenuItem" Header="_Reset zoom" InputGestureText="Ctrl+0" Click="ResetZoomMenuItem_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="PreviewMenuItem" Header="_Markdown preview" IsCheckable="True" Click="PreviewMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="ThemeMenuItem" Header="App _theme">
                    <MenuItem x:Name="ThemeSystemMenuItem" Header="_System" IsCheckable="True" IsChecked="True" Click="ThemeMenuItem_Click" />
                    <MenuItem x:Name="ThemeLightMenuItem" Header="_Light" IsCheckable="True" Click="ThemeMenuItem_Click" />
                    <MenuItem x:Name="ThemeDarkMenuItem" Header="_Dark" IsCheckable="True" Click="ThemeMenuItem_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="MarkdownMenuItem" Header="_Markdown" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="InsertTableMenuItem" Header="Insert _table" Click="InsertTableMenuItem_Click" />
                <MenuItem x:Name="AddTableRowMenuItem" Header="Add table _row" Click="AddTableRowMenuItem_Click" />
                <Separator />
                <MenuItem x:Name="InsertImageMenuItem" Header="Insert _image..." Click="InsertImageMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="PrivacyMenuItem" Header="_Privacy" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="CaptureExclusionMenuItem"
                          Header="_Exclude window from capture"
                          IsCheckable="True"
                          Click="CaptureExclusionMenuItem_Click" />
            </MenuItem>
            <MenuItem x:Name="HelpMenuItem" Header="_Help" ItemContainerStyle="{StaticResource MenuBarItemStyle}">
                <MenuItem x:Name="AboutMenuItem" Header="_About Memojang" IsEnabled="False" />
            </MenuItem>
        </Menu>
                <Border Grid.Row="2"
                        Background="{DynamicResource AppTopBarBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="8,3"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <DockPanel LastChildFill="False">
                        <StackPanel x:Name="MarkdownToolbarPanel"
                                    Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <Button x:Name="ToolbarHeadingButton"
                                    Content="H1"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarHeadingButton_Click" />
                            <Button x:Name="ToolbarListButton"
                                    Content="☷"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarListButton_Click" />
                            <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                            <Button x:Name="ToolbarBoldButton"
                                    Content="B"
                                    FontWeight="Bold"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarBoldButton_Click" />
                            <Button x:Name="ToolbarItalicButton"
                                    Content="I"
                                    FontStyle="Italic"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarItalicButton_Click" />
                            <Button x:Name="ToolbarStrikeButton"
                                    Content="S"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarStrikeButton_Click" />
                            <Button x:Name="ToolbarLinkButton"
                                    Content="🔗"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarLinkButton_Click" />
                            <Button x:Name="ToolbarTableButton"
                                    Content="▦"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="InsertTableMenuItem_Click" />
                            <Button x:Name="ToolbarImageButton"
                                    Content="이미지"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarImageButton_Click" />
                            <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                            <Button x:Name="ToolbarPreviewButton"
                                    Content="미리 보기"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarPreviewButton_Click" />
                            <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                        </StackPanel>
                        <StackPanel x:Name="ViewToolbarPanel"
                                    Orientation="Horizontal"
                                    DockPanel.Dock="Left">
                            <Button x:Name="ToolbarSmallFontButton"
                                    Content="A-"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarFontSizeButton_Click" />
                            <TextBox x:Name="ToolbarFontSizeTextBox"
                                     Width="56"
                                     Height="28"
                                     Margin="4,2"
                                     Background="{DynamicResource AppControlBrush}"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     BorderThickness="1"
                                     CaretBrush="{DynamicResource AppTextBrush}"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppTextBrush}"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Editor font size"
                                     KeyDown="ToolbarFontSizeTextBox_KeyDown"
                                     LostFocus="ToolbarFontSizeTextBox_LostFocus"
                                     shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                            <Button x:Name="ToolbarLargeFontButton"
                                    Content="A+"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Click="ToolbarFontSizeButton_Click" />
                            <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                            <ToggleButton x:Name="ToolbarDarkModeButton"
                                          Content="Dark"
                                          Style="{StaticResource CaptureExclusionToggleStyle}"
                                          Click="ToolbarDarkModeButton_Click" />
                            <Separator Style="{StaticResource ToolbarSeparatorStyle}" />
                        </StackPanel>
                        <ToggleButton x:Name="ToolbarPrivacyButton"
                                      Content="캡처시 제외"
                                      Style="{StaticResource CaptureExclusionToggleStyle}"
                                      Click="ToolbarPrivacyButton_Click" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="FindPanel"
                DockPanel.Dock="Top"
                Background="{DynamicResource AppControlBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8"
                Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="FindLabelText" Foreground="{DynamicResource AppTextBrush}" Text="Find"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="FindTextBox" Width="240" KeyDown="FindTextBox_KeyDown" />
                <Button x:Name="FindPreviousButton" Content="Previous" Margin="8,0,0,0" MinWidth="84" Click="FindPreviousButton_Click" />
                <Button x:Name="FindNextButton" Content="Next" Margin="8,0,0,0" MinWidth="72" Click="FindNextButton_Click" />
                <TextBlock x:Name="ReplaceLabelText" Foreground="{DynamicResource AppTextBrush}" Text="Replace"
                           VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox x:Name="ReplaceTextBox" Width="220" KeyDown="FindTextBox_KeyDown" />
                <Button x:Name="ReplaceButton" Content="Replace" Margin="8,0,0,0" MinWidth="72" Click="ReplaceButton_Click" />
                <Button x:Name="ReplaceAllButton" Content="All" Margin="8,0,0,0" MinWidth="64" Click="ReplaceAllButton_Click" />
                <Button x:Name="CloseFindButton" Content="Close" Margin="8,0,0,0" MinWidth="72" Click="CloseFindButton_Click" />
                <TextBlock x:Name="FindStatusText"
                           Foreground="{DynamicResource AppMutedTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
            </DockPanel>
        </Border>

        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom"
                   MinHeight="28"
                   Background="{DynamicResource AppControlBrush}"
                   Foreground="{DynamicResource AppTextBrush}">
            <StatusBarItem>
                <TextBlock x:Name="CaretStatusText" MinWidth="92" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="ChangeStatusText" MinWidth="116" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="CharacterCountStatusText" MinWidth="88" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="PrivacyStatusText" MinWidth="148" Text="Capture visible" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="DocumentModeStatusText" MinWidth="72" Text="Text" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ZoomLabelText"
                               Text="Zoom"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" />
                    <Slider x:Name="ZoomSlider"
                            Width="140"
                            Minimum="50"
                            Maximum="200"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            Value="100"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <TextBlock x:Name="ZoomStatusText"
                               MinWidth="48"
                               Text="100%"
                               TextAlignment="Right"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="EncodingStatusText" MinWidth="56" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="LineEndingStatusText" MinWidth="44" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="EditorTextBox"
                    Grid.Column="0"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                     AllowDrop="True"
                     Background="{DynamicResource AppEditorBackgroundBrush}"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="14"
                     Foreground="{DynamicResource AppEditorForegroundBrush}"
                     HorizontalScrollBarVisibility="Disabled"
                     Padding="12"
                     SpellCheck.IsEnabled="False"
                     TextChanged="EditorTextBox_TextChanged"
                     Drop="EditorTextBox_Drop"
                     PreviewDragOver="EditorTextBox_PreviewDragOver"
                     SelectionChanged="EditorTextBox_SelectionChanged"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <Border x:Name="PreviewPane"
                    Grid.Column="1"
                    Background="{DynamicResource AppPreviewBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <FlowDocumentScrollViewer x:Name="PreviewViewer"
                                          IsToolBarVisible="False"
                                          Padding="18" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
