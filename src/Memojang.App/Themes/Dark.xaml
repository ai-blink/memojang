<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppWindowBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="AppControlBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="AppTopBarBrush" Color="#202020" />
    <SolidColorBrush x:Key="AppTabBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="AppMenuHoverBrush" Color="#363636" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#777777" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#454545" />
    <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AppEditorForegroundBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#242424" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AppScrollBarTrackBrush" Color="#242424" />
    <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#6A6A6A" />
    <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#858585" />
    <SolidColorBrush x:Key="AppScrollBarThumbPressedBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="AppToggleTrackOffBrush" Color="#5A5A5A" />
    <SolidColorBrush x:Key="AppToggleThumbBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#454545" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0E639C" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2B2B2B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F3F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#454545" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#363636" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#454545" />
    <SolidColorBrush x:Key="MenuItem.Pressed.Background" Color="#363636" />
    <SolidColorBrush x:Key="MenuItem.Pressed.Border" Color="#454545" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#363636" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#454545" />
    <SolidColorBrush x:Key="MenuItem.Submenu.Background" Color="#2B2B2B" />
    <SolidColorBrush x:Key="MenuItem.Submenu.Border" Color="#454545" />
    <SolidColorBrush x:Key="MenuItem.Disabled.Foreground" Color="#777777" />
</ResourceDictionary>
