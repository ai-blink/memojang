<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppWindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#5F6368" />
    <SolidColorBrush x:Key="AppControlBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="AppTopBarBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="AppTabBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppMenuHoverBrush" Color="#E8F2FF" />
    <SolidColorBrush x:Key="AppDisabledTextBrush" Color="#777777" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#DADCE0" />
    <SolidColorBrush x:Key="AppEditorBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppEditorForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#FBFBFB" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#0067C0" />
    <SolidColorBrush x:Key="AppScrollBarTrackBrush" Color="#F1F1F1" />
    <SolidColorBrush x:Key="AppScrollBarThumbBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="AppScrollBarThumbHoverBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="AppScrollBarThumbPressedBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="AppToggleTrackOffBrush" Color="#9B9B9B" />
    <SolidColorBrush x:Key="AppToggleThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#F7F7F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#DADCE0" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DDEEFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F7F7F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#1A1A1A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6B6B6B" />
    <SolidColorBrush x:Key="Menu.Static.Background" Color="#F7F7F7" />
    <SolidColorBrush x:Key="Menu.Static.Border" Color="#DADCE0" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Background" Color="#E8F2FF" />
    <SolidColorBrush x:Key="MenuItem.Highlight.Border" Color="#C8E3FF" />
    <SolidColorBrush x:Key="MenuItem.Pressed.Background" Color="#DDEEFF" />
    <SolidColorBrush x:Key="MenuItem.Pressed.Border" Color="#9FCBFF" />
    <SolidColorBrush x:Key="MenuItem.Selected.Background" Color="#E8F2FF" />
    <SolidColorBrush x:Key="MenuItem.Selected.Border" Color="#C8E3FF" />
    <SolidColorBrush x:Key="MenuItem.Submenu.Background" Color="#F7F7F7" />
    <SolidColorBrush x:Key="MenuItem.Submenu.Border" Color="#DADCE0" />
    <SolidColorBrush x:Key="MenuItem.Disabled.Foreground" Color="#777777" />
</ResourceDictionary>
